# Server Settings
MAX_UPLOAD_SIZE_MB=20
MAX_DURATION_SECONDS=120
MIN_DURATION_SECONDS=2
MIN_SPEECH_SECONDS=1
TEMP_AUDIO_DIR=data/temp

# Component Versions
MODEL_VERSION=baseline-v1
PREPROCESSING_VERSION=v1
RISK_POLICY_VERSION=v1

# Detector Configuration
DETECTOR_BACKEND=dummy
DETECTOR_MODEL_ID=Vansh180/deepfake-audio-wav2vec2
DETECTOR_SPOOF_LABEL=spoof
DETECTOR_SPOOF_LABEL_INDEX=1
DETECTOR_TARGET_SAMPLE_RATE=16000
MODEL_CACHE_DIR=data/model-cache

# Risk Policy Thresholds
LOW_RISK_MAX=39
MEDIUM_RISK_MAX=69

# Security Engine & Cryptographic Secrets
VOICE_SALT=DHVANI_VOICE_TOKEN_SALT_V5
AUDIT_SECRET=DHVANI_AUDIT_SIGNING_KEY_V5
SESSION_TTL_SECONDS=3600
SECURE_MEMORY_WIPE=true